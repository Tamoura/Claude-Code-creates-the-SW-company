# ConnectBPM — copy to .env and fill in. NEVER commit .env.
#
# Ports are registered in .claude/PORT-REGISTRY.md: web 3123, api 5018.
# Local infrastructure host ports are unique to this product: pg 5438, redis 6388.

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL is the SOLE source of truth for state, evidence and meters
# (ADR-004, ADR-007, ADR-009).
# The application role must be NEITHER superuser NOR BYPASSRLS (ADR-004 §3):
# FORCE ROW LEVEL SECURITY binds the table owner, but nothing binds a superuser
# or a BYPASSRLS role, so pointing this at `postgres` silently removes the
# second isolation layer while every test still passes.
# Create the roles with `pnpm --filter @connectbpm/api db:roles` BEFORE the
# first migration.
DATABASE_URL=postgresql://connectbpm_app:connectbpm_app_dev@localhost:5438/connectbpm_dev
DATABASE_URL_MIGRATOR=postgresql://connectbpm_migrator:connectbpm_migrator_dev@localhost:5438/connectbpm_dev
# The JOB RUNNER's connection (ADR-009, ADR-010). Same posture as the app role,
# separate from it because it is the ONLY role granted EXECUTE on the two
# cross-tenant claim functions. The runner process sets DATABASE_URL to this
# value; the API must NOT. If the API could lease jobs, a bug on the HTTP
# surface could mark every tenant's timers CLAIMED and stop the engine for
# everyone.
DATABASE_URL_RUNNER=postgresql://connectbpm_runner:connectbpm_runner_dev@localhost:5438/connectbpm_dev
# Administrative connection, used ONLY by db:roles to create the five roles.
# `connectbpm_job_claimer` is created NOLOGIN and has no URL by design: the only
# way to act as it is to call a SECURITY DEFINER function it owns (ADR-010).
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5438/connectbpm_dev

POSTGRES_DB=connectbpm_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Change every one of these in any environment that is not a laptop.
DB_APP_PASSWORD=connectbpm_app_dev
DB_MIGRATOR_PASSWORD=connectbpm_migrator_dev
DB_RECONCILER_PASSWORD=connectbpm_reconciler_dev
DB_RUNNER_PASSWORD=connectbpm_runner_dev

# ── Redis ────────────────────────────────────────────────────────────────────
# Cache and SOFT counters only. Never a value correctness depends on (FR-045).
REDIS_URL=redis://localhost:6388

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string-32c
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5018
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3123
FRONTEND_URL=http://localhost:3123
API_URL=http://localhost:5018

# ── Job runner (ADR-009) ─────────────────────────────────────────────────────
# One image, two roles. Set true only in the runner process.
RUN_JOB_RUNNER=false
JOB_WORKER_COUNT=8
JOB_BATCH_SIZE=200

# ── Web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5018

# ── E2E ──────────────────────────────────────────────────────────────────────
E2E_BASE_URL=http://localhost:3123
E2E_API_URL=http://localhost:5018
