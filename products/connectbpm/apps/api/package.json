{
  "name": "@connectbpm/api",
  "version": "0.1.0",
  "private": true,
  "description": "ConnectBPM API — workflow engine, evidence ledger, multi-tenant control plane",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:generate": "prisma generate",
    "db:roles": "tsx scripts/provision-db-roles.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio",
    "lint": "eslint src/ tests/ scripts/",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "gate:rls": "tsx scripts/check-rls.ts",
    "gate:rls:live": "tsx scripts/check-rls.ts --live",
    "gate:metering": "tsx scripts/check-metering-boundary.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^5.10.0",
    "cron-parser": "^4.9.0",
    "fastify": "^5.7.4",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.3.2",
    "luxon": "^3.5.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@swc/core": "^1.15.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.12",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.11.16",
    "eslint": "^9.39.3",
    "eslint-plugin-no-secrets": "^1.1.2",
    "eslint-plugin-security": "^3.0.1",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "prisma": "^5.10.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.56.0"
  }
}
